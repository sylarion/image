# Environment variables for Catalog AI

# Real provider configuration. The interactive application never uses synthetic
# detections or generated images when these credentials are unavailable.
AI_MODE=real
ANALYSIS_PROVIDER=gemini
ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
VALIDATION_PROVIDER=gemini
VALIDATION_MODEL=gemini-2.5-flash
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-3.1-flash-lite-image
# USD estimados por imagen para el modelo seleccionado: completar con una tarifa verificada.
# Obligatorio para cotizar con Gemini; no se asume un precio por defecto.
GENERATION_COST_PER_IMAGE_USD=
# false permite analizar y revisar con el nivel gratuito de Gemini sin crear imágenes.
# Cambialo a true sólo si configurás la API key del proveedor seleccionado.
GENERATION_ENABLED=false
FAL_KEY=
MAX_REAL_GENERATIONS=8
